{
    "name": "crownfall-playcanvas",
    "version": "0.0.0",
    "private": true,
    "description": "Crownfall Arena technical foundation",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "test": "vitest run",
        "test:browser": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "playcanvas": "^2.23.1"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "@playwright/test": "^1.56.0",
        "@types/node": "^26.6.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vitest": "^4.0.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
